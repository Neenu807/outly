# Outly API — environment template (ARCHITECTURE §27)
#
# Copy to `.env` and fill in. Every key below is parsed by src/config/env.js at
# boot; a missing REQUIRED value crashes the process with a readable message.
# This file is committed with BLANK values and is updated in the same commit
# that introduces a new variable. `.env` itself is never committed.
#
# Generate secrets with: openssl rand -base64 48

# ---- server core (required) ----
NODE_ENV=development
PORT=5000
MONGODB_URI=

# ---- auth (required) ----
# Both secrets must be at least 32 characters and MUST differ from each other,
# so a leaked access secret cannot mint refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=12

# ---- cors / cookies ----
# CORS_ORIGINS is a comma-separated allowlist and is authoritative when set.
# Production (Vercel frontend + Render/Railway API) needs COOKIE_SECURE=true
# and COOKIE_SAMESITE=none, or the refresh cookie is silently dropped.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- email · Nodemailer (Phase 1 transport, Phase 6 notifications) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- cloudinary (Phase 4) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=outly

# ---- ai provider (Phase 5) ----
# AI_ENABLED=false is a hard kill switch — discovery falls back to templated
# explanations. Setting it to true REQUIRES the three values below it.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_MAX_TOKENS=300
AI_TIMEOUT_MS=8000
AI_DAILY_CALL_CAP=500

# ---- twilio (Phase 6) ----
# SMS_ENABLED=true REQUIRES all three Twilio values.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_TIMEOUT_MS=10000
SMS_DAILY_CAP_PER_USER=10

# ---- limits / logging ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
