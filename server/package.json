{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Outly REST API — Express + Mongoose",
  "license": "ISC",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "migrate:organizers": "node scripts/migrateOrganizers.js",
    "seed": "echo \"Phase 2: scripts/seed.js\" && exit 1",
    "reconcile": "echo \"Phase 3: scripts/reconcile.js\" && exit 1",
    "create-admin": "node scripts/createAdmin.js",
    "create-indexes": "node scripts/createIndexes.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.0",
    "nodemailer": "^10.0.9",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
