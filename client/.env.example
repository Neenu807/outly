# Outly client — environment template (ARCHITECTURE §27)
#
# VITE_API_URL is the ONLY client variable, and that is deliberate.
# Vite inlines every VITE_* value into the browser bundle at build time, so a
# secret with a VITE_ prefix is a published secret. Never add one.

VITE_API_URL=http://localhost:5000/api/v1
